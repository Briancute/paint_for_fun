#version 300 es
precision highp float;uniform sampler2D currentFrame;uniform sampler2D previousFrame;uniform vec2 grid;in vec2 vUv;out vec4 color;float luma(vec3 rgb){return dot(rgb,vec3(0.299,0.587,0.114));}float errorAt(vec2 uv,vec2 offset){float error=0.0;for(int y=-1;y<=1;y++){for(int x=-1;x<=1;x++){vec2 tap=uv+vec2(float(x),float(y))/grid;float a=luma(texture(currentFrame,tap).rgb);float b=luma(texture(previousFrame,tap+offset/grid).rgb);error+=abs(a-b);}}return error/9.0;}void main(){vec2 best=vec2(0.0);float bestError=errorAt(vUv,best);float change=bestError;for(int level=0;level<3;level++){float stride=exp2(float(2-level));vec2 origin=best;for(int y=-1;y<=1;y++){for(int x=-1;x<=1;x++){vec2 candidate=origin+vec2(float(x),float(y))*stride;float error=errorAt(vUv,candidate)+dot(candidate,candidate)*0.00015;if(error<bestError){bestError=error;best=candidate;}}}}color=vec4((best+8.0)/16.0,change,1.0);}