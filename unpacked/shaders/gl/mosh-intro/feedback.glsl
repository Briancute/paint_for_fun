#version 300 es
precision highp float;uniform sampler2D scene;uniform sampler2D history;uniform sampler2D previousFrame;uniform sampler2D motion;uniform vec2 res;uniform vec2 grid;uniform vec3 placement;uniform float transfer;uniform float release;uniform float frames;uniform float hold;uniform float clean;in vec2 vUv;out vec4 color;void main(){vec2 liveUv=(vUv-0.5)/placement.x+0.5-placement.yz;vec3 live=texture(scene,clamp(liveUv,0.0,1.0)).rgb;if(clean>0.5){color=vec4(live,1.0);return;}if(hold>0.5){color=texture(history,vUv);return;}vec2 block=(floor(vUv*grid)+0.5)/grid;vec4 field=texture(motion,block);vec2 vector=floor(field.rg*16.0-8.0+0.5)/grid;vec2 source=clamp(vUv+vector,0.5/res,1.0-0.5/res);vec3 retained=texelFetch(history,ivec2(source*res),0).rgb;vec3 prediction=texture(previousFrame,clamp(block+vector,0.0,1.0)).rgb;vec3 currentBlock=texture(scene,clamp((block-0.5)/placement.x+0.5-placement.yz,0.0,1.0)).rgb;vec3 residual=currentBlock-prediction;vec3 carried=clamp(retained+residual*transfer*0.75,0.0,1.0);float activity=smoothstep(0.015,0.18,field.b);float mismatch=length(currentBlock-retained)/1.732;float recover=release*release;float refresh=(0.004+activity*0.4)*transfer+recover*(0.1+mismatch*0.5);float weight=1.0-pow(1.0-clamp(refresh,0.0,1.0),frames);color=vec4(mix(carried,live,weight),1.0);}