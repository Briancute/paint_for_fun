#version 300 es
precision highp float;uniform vec2 res;uniform float amt;uniform float seed;uniform float cell;in vec2 vUv;out vec4 color;float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453123);}const float FLOOR=0.17;const float SPARK_AT=0.988;const float SPARK=0.6;const float BAND_ROWS=7.0;const float BAND_AT=0.93;const float BAND_GAIN=2.6;const float CHROMA=0.05;void main(){vec2 id=floor(vUv*res/max(cell,1.0));float n=hash(id+seed);float v=n*n*FLOOR+step(SPARK_AT,hash(id*1.7+seed+5.3))*SPARK;float row=floor(vUv.y*res.y/(max(cell,1.0)*BAND_ROWS));float band=step(BAND_AT,hash(vec2(row,seed)+21.7));v=mix(v,v*BAND_GAIN,band);vec3 rgb=vec3(v)+(vec3(hash(id+3.1),hash(id+7.9),hash(id+11.3))-0.5)*CHROMA*step(0.5,n);color=vec4(max(rgb,0.0),amt);}