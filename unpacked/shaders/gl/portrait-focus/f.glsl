#version 300 es
precision highp float;uniform sampler2D tex;uniform vec2 focus;in vec2 vUv;out vec4 color;vec4 filterFocus(vec2 uv,float r){vec2 ts=vec2(textureSize(tex,0));float tpp=max(length(dFdx(uv)*ts),length(dFdy(uv)*ts));float rr=max(r,tpp);float lod=max(log2(rr/3.),0.);vec2 h=exp2(lod)*.5/ts;vec2 lo=h;vec2 hi=1.-h;vec4 acc=textureLod(tex,clamp(uv,lo,hi),lod);float wsum=1.;for(int i=0;i<6;i++){float a=float(i)*1.0472;vec2 d=vec2(cos(a),sin(a))*.35;acc+=.783*textureLod(tex,clamp(uv+d*rr/ts,lo,hi),lod);wsum+=.783;}for(int i=0;i<8;i++){float a=(float(i)+.5)*.7854;vec2 d=vec2(cos(a),sin(a))*.7;acc+=.375*textureLod(tex,clamp(uv+d*rr/ts,lo,hi),lod);wsum+=.375;}for(int i=0;i<12;i++){float a=float(i)*.5236;vec2 d=vec2(cos(a),sin(a))*1.05;acc+=.110*textureLod(tex,clamp(uv+d*rr/ts,lo,hi),lod);wsum+=.110;}return acc/wsum;}void main(){color=filterFocus(vUv,focus.x*mix(1.,focus.y,smoothstep(.45,1.,vUv.y)));}