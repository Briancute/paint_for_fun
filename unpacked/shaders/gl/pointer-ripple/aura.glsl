#version 300 es
precision highp float;uniform sampler2D inkField;uniform vec2 viewport;uniform float padding;uniform float scroll;in vec2 vUv;out vec4 color;float hash(vec2 p){vec3 q=fract(vec3(p.xyx)*.1031);q+=dot(q,q.yzx+33.33);return fract((q.x+q.y)*q.z);}float noise(vec2 p){vec2 cell=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(hash(cell),hash(cell+vec2(1.,0.)),f.x),mix(hash(cell+vec2(0.,1.)),hash(cell+1.),f.x),f.y);}void main(){vec2 point=vec2(vUv.x*viewport.x,(1.-vUv.y)*(viewport.y+2.*padding)-padding);vec2 uv=point/viewport;if(any(lessThan(uv,vec2(0.)))||any(greaterThan(uv,vec2(1.)))){color=vec4(0.);return;}float density=texture(inkField,uv).r;if(density<=.03){color=vec4(0.);return;}float wet=smoothstep(.03,.4,density);vec2 paper=point+vec2(0.,scroll);float fibers=mix(.72,1.,noise(paper/74.));float dither=(fract(sin(dot(floor(paper*2.),vec2(12.9898,78.233)))*43758.5453)-.5)/255.;float opacity=wet*fibers*.32+dither*smoothstep(0.,.05,wet)/.28;vec2 inset=min(point,viewport-point);float edgeFade=smoothstep(0.,48.,min(inset.x,inset.y));color=vec4(vec3(.28),max(0.,opacity)*edgeFade);}