#version 300 es
precision highp float;uniform sampler2D current;uniform vec2 texel;uniform float aspect;uniform float radius;uniform float shift;uniform float origin;uniform float clampEdges;uniform vec2 motionScale;uniform float brushGain;uniform vec2 viewport;uniform float cloudRadius;uniform float cloudPhase;uniform mat4 dropsA;uniform mat4 dropsB;uniform mat4 flowA;uniform mat4 flowB;in vec2 vUv;out vec4 color;vec4 sampleField(vec2 uv){if(clampEdges<.5&&(any(lessThan(uv,vec2(0.)))||any(greaterThan(uv,vec2(1.)))))return vec4(0.);vec2 inset=.5/vec2(textureSize(current,0));return texture(current,clamp(uv,inset,1.-inset));}float hash(vec2 p){vec3 q=fract(vec3(p.xyx)*.1031);q+=dot(q,q.yzx+33.33);return fract((q.x+q.y)*q.z);}float noise(vec2 p){vec2 cell=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(hash(cell),hash(cell+vec2(1.,0.)),f.x),mix(hash(cell+vec2(0.,1.)),hash(cell+1.),f.x),f.y);}void main(){vec2 source=vUv+vec2(0.,shift);vec4 previous=sampleField(source);vec2 uv=source-previous.gb*.5;vec4 center=sampleField(uv);vec4 average=(sampleField(uv-vec2(texel.x,0.))+sampleField(uv+vec2(texel.x,0.))+sampleField(uv-vec2(0.,texel.y))+sampleField(uv+vec2(0.,texel.y)))*.25;float density=mix(center.r,average.r,.12822)*.98742;vec2 flow=mix(center.gb,average.gb,.09446)*.95917;vec2 cell=(vUv+vec2(0.,origin))/texel/9.;float fibers=noise(cell);float cloud=0.;if(cloudRadius>0.){vec2 p=(vUv+vec2(0.,origin))*viewport;float diagonal=.45*sin((p.x+p.y)*.047);vec2 curl=vec2(sin(p.x*.022)*cos(p.y*.025)+diagonal,-cos(p.x*.022)*sin(p.y*.025)-diagonal);vec2 drift=mat2(cos(cloudPhase),sin(cloudPhase),-sin(cloudPhase),cos(cloudPhase))*curl;vec2 carried=source-previous.gb*.5-drift*(42./120.)*previous.a/max(viewport,vec2(1.));cloud=mix(sampleField(carried).a,average.a,.01653)*.98265;}for(int i=0;i<8;i++){vec4 stroke=i<4?dropsA[i]:dropsB[i-4];vec3 force=i<4?flowA[i].xyz:flowB[i-4].xyz;if(force.z<=0.)continue;force.z*=max(1.,brushGain);vec2 stretch=vec2(aspect,1.);vec2 path=(stroke.zw-stroke.xy)*stretch;vec2 delta=(vUv-stroke.xy)*stretch;float along=clamp(dot(delta,path)/max(dot(path,path),.0000001),0.,1.);delta-=path*along;float falloff=max(0.,1.-length(delta)/radius);falloff=falloff*falloff*falloff*(falloff*(falloff*6.-15.)+10.);falloff*=mix(.92,1.,fibers)*radius/(radius+length(path)*.5);density+=falloff*force.z*2.4;flow=mix(flow,force.xy,1.-exp(-falloff*force.z*10.));if(cloudRadius>0.){float distance=dot(delta,delta)/(cloudRadius*cloudRadius);float dust=pow(max(0.,1.-distance),2.);dust*=mix(.8,1.,fibers)*cloudRadius/(cloudRadius+length(path)*.5);cloud+=dust*force.z*1.6;}}vec2 physicalScale=mix(vec2(1.),motionScale,greaterThan(motionScale,vec2(0.)));color=vec4(clamp(density,0.,1.),clamp(flow*physicalScale,vec2(-.016),vec2(.016))/physicalScale,clamp(cloud,0.,1.));}