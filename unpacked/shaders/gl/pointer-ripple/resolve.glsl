#version 300 es
precision highp float;uniform sampler2D current;uniform sampler2D previous;uniform vec2 texel;uniform float phase;uniform vec2 offsets;uniform vec3 focus;uniform float aspect;uniform float clampEdges;in vec2 vUv;out vec4 color;vec4 state(vec2 uv){vec2 currentUv=uv+vec2(0.,offsets.x);vec2 previousUv=uv+vec2(0.,offsets.y);vec2 inset=.5/vec2(textureSize(current,0));vec4 a=vec4(0.),b=vec4(0.);if(clampEdges>.5||(all(greaterThanEqual(currentUv,vec2(0.)))&&all(lessThanEqual(currentUv,vec2(1.)))))a=texture(current,clamp(currentUv,inset,1.-inset));if(clampEdges>.5||(all(greaterThanEqual(previousUv,vec2(0.)))&&all(lessThanEqual(previousUv,vec2(1.)))))b=texture(previous,clamp(previousUv,inset,1.-inset));return mix(b,a,phase);}void main(){vec4 center=state(vUv);vec4 neighbors=(state(vUv-vec2(texel.x,0.))+state(vUv+vec2(texel.x,0.))+state(vUv-vec2(0.,texel.y))+state(vUv+vec2(0.,texel.y)))*.25;color=mix(center,neighbors,.35);vec2 proximity=(vUv-focus.xy)*vec2(aspect,1.)/max(focus.z*.35,.00001);color.a*=1.-.7*exp(-dot(proximity,proximity));}