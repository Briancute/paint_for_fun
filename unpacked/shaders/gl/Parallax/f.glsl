#version 300 es
precision highp float;uniform sampler2D tex;uniform sampler2D depthTex;uniform sampler2D normalTex;uniform float o;uniform vec2 cover;uniform vec2 ptr;uniform float depthAmt;uniform float relief;uniform float edgeResolve;in vec2 vUv;in vec2 vQuv;out vec4 color;float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}void main(){float d=texture(depthTex,vQuv).r;vec2 dir=ptr*depthAmt/cover;vec2 uv=vUv+dir*(d-0.5);vec3 c=texture(tex,uv).rgb;if(relief>0.001){vec3 n=texture(normalTex,vQuv).rgb*2.0-1.0;vec3 L=normalize(vec3(ptr*1.4,1.0));float diff=dot(normalize(n),L);c+=(diff-0.35)*relief;}float inset=1.0-max(abs(vQuv.x*2.0-1.0),abs(vQuv.y*2.0-1.0));float breakup=1.0-edgeResolve;float grain=hash(floor(vQuv*vec2(31.0,43.0))+4.7);float threshold=breakup*mix(0.025,0.085,grain);float feather=mix(0.018,0.05,breakup);float brokenEdge=smoothstep(threshold-feather,threshold+feather,inset);float featheredEdge=mix(0.22,1.0,brokenEdge);float edgeAlpha=mix(1.0,featheredEdge,breakup);color=vec4(c,o*edgeAlpha);}