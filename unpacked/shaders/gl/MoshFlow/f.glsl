#version 300 es
precision highp float;uniform vec2 res;uniform float uTime;uniform float uDt;uniform float uVar;uniform vec2 uDir;uniform float uMode;in vec2 vUv;out vec4 color;const float FOV=1.4;mat2 r2(float a){float c=cos(a),s=sin(a);return mat2(c,-s,s,c);}float hash21(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}float vnoise(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(hash21(i),hash21(i+vec2(1,0)),f.x),mix(hash21(i+vec2(0,1)),hash21(i+vec2(1,1)),f.x),f.y);}float fbm(vec2 p){float v=0.0,a=0.5;for(int i=0;i<4;i++){v+=a*vnoise(p);p*=2.0;a*=0.5;}return v;}float potential(vec2 p){return vnoise(p)+0.22*vnoise(p*2.0);}vec2 curl(vec2 p){float e=0.02;float dx=potential(p+vec2(e,0.0))-potential(p-vec2(e,0.0));float dy=potential(p+vec2(0.0,e))-potential(p-vec2(0.0,e));return vec2(dy,-dx)/(2.0*e);}float map(vec3 p){p.xy*=r2(p.z*0.14+uVar*6.2831853);float g=sin(p.x)*cos(p.y)+sin(p.y)*cos(p.z)+sin(p.z)*cos(p.x);return(abs(g)-0.28)*0.5;}float trace(vec3 ro,vec3 rd){float t=0.05,d;for(int i=0;i<72;i++){d=map(ro+rd*t);t+=d;if(d<0.008||t>14.0)break;}return t;}void cam(float t,out vec3 ro,out mat3 m){if(dot(uDir,uDir)<0.0001){float a=t+uVar*6.2831853;ro=vec3(0.4*sin(a*0.7),0.35*cos(a*0.6),t*0.9);vec3 fw=normalize(vec3(0.35*sin(a*0.5),0.28*cos(a*0.4),1.0));vec3 cu=normalize(cross(vec3(0,1,0),fw));vec3 cv=cross(fw,cu);m=mat3(cu,cv,fw);}else{vec2 axis=normalize(uDir);vec2 side=vec2(-axis.y,axis.x);float seed=uVar*19.73;float wander=(fbm(vec2(t*0.24+seed,seed*0.37))-0.5)*0.42;float pace=(fbm(vec2(t*0.51+seed*1.7,seed+4.2))-0.5)*0.1;vec2 truck=axis*(t*1.2+pace)+side*wander;ro=vec3(0.0,0.0,2.0)+vec3(truck,0.0);vec3 fw=vec3(0.0,0.0,1.0);vec3 cu=normalize(cross(vec3(0.0,1.0,0.0),fw));vec3 cv=cross(fw,cu);m=mat3(cu,cv,fw);}}void main(){if(uMode>1.5){vec2 axis=dot(uDir,uDir)>0.0?uDir/max(length(uDir),1.0):vec2(0.0,1.0);vec2 p=vec2(vUv.y*3.4+uTime*0.22,vUv.x*2.1+uVar*17.0);float broad=fbm(p);float bands=vnoise(vec2(floor(vUv.y*18.0)*0.37+uVar*11.3,uTime*0.48));float speed=mix(0.018,0.042,broad)+(bands-0.5)*0.008;vec2 fl=axis*speed;color=vec4(clamp(fl,-0.5,0.5)+0.5,1.0,1.0);return;}if(uMode>0.5){vec2 p=vUv*2.4+vec2(uVar*17.0,uTime*0.6);vec2 fl=curl(p)*0.06;color=vec4(clamp(fl,-0.5,0.5)+0.5,1.0,1.0);return;}vec2 frag=2.0*vUv-1.0;frag.x*=res.x/res.y;vec3 ro;mat3 m;cam(uTime,ro,m);vec3 rd=m*normalize(vec3(frag,FOV));float t=trace(ro,rd);vec3 p=ro+rd*t;vec3 roP;mat3 mP;cam(uTime-uDt,roP,mP);vec3 od=(p-roP)*mP;vec2 pf=od.xy/max(od.z,1e-4)*FOV;pf.x/=res.x/res.y;vec2 prevUv=pf*0.5+0.5;float valid=(t<14.0&&od.z>0.0)?1.0:0.0;vec2 mv=(prevUv-vUv)*valid;color=vec4(clamp(mv,-0.5,0.5)+0.5,valid,1.0);}