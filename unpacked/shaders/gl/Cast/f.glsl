#version 300 es
precision highp float;uniform float o;uniform float ar;uniform vec2 mk;uniform float yaw;uniform float sh;uniform float sp;in vec2 vUv;out vec4 color;float pool(vec2 p,vec2 c,vec2 r,float k){vec2 d=(p-c)/r;return exp(-dot(d,d)*k);}void main(){vec2 p=(vUv-0.5)*vec2(ar,1.);float s=sin(yaw);float face=abs(cos(yaw));float fp=mix(0.60,1.,face);float shadow=sh*pool(p,vec2(mk.x*0.08*s,-mk.y*0.88),mk*vec2(0.88*fp,0.34),3.4);float seat=pool(p,vec2(mk.x*0.14*s,-mk.y*1.34),mk*vec2(0.94*fp,0.26),4.2);float band=pow(abs(sin(2.*yaw)),4.);float sweep=face*band*pool(p,vec2(mk.x*0.45*s,-mk.y*1.50),mk*vec2(1.30*fp,0.78),3.8);float net=sp*(0.15*seat+sweep)-shadow;color=vec4(vec3(step(0.,net)),abs(net)*o);}