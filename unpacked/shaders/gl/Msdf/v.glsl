precision highp float;in vec2 pos;in vec4 halo;in float gx;in vec2 ub;in vec3 av;in float al;in float dxm;in float ci;in float tr;in float ord;in float entry;const float CHARSTAG=0.55;uniform mat4 proj;uniform mat4 view;uniform mat4 model;uniform float fx;uniform float stag;uniform float nl;uniform float sp;uniform float dir;uniform vec4 rise;uniform float riseDistance;uniform float riseExit;uniform float lineStep;uniform float inkActive;out float vGx;out vec2 vUb;out float vV;out vec2 vVBounds;out float vPl;out float vLd;out vec2 vW;out float vY;out vec2 vMask;out vec2 vLocal;void main(){vec4 trim=inkActive<.5?halo:vec4(0.);vec2 point=pos-trim.xy;float plr=clamp(fx*(1.+stag*max(nl-1.,0.))-al*stag,0.,1.);float pe=1.-pow(1.-plr,6.);float span=stag*max(nl-1.,0.)+CHARSTAG;float plc=clamp(fx*(1.+span)-al*stag-ord*CHARSTAG,0.,1.);float ease=smoothstep(0.,1.,plc);float trk=tr*(1.-ease);float x=point.x-dir*(1.-pe)*abs(dxm)+ci*sp+trk;float y=point.y;vMask=rise.zw+al*lineStep;if(rise.y>0.){float progress=clamp((rise.x-entry)/rise.y,0.,1.);float lifted=progress>=1.?1.:1.-exp2(-10.*progress);float offset=1.-lifted;if(progress>0.)offset=mix(offset,-1.1,riseExit);y+=riseDistance*offset;}vec4 w=model*vec4(x,y,0.,1.);vY=y;vLocal=point;vW=w.xy;gl_Position=proj*view*w;vGx=gx-trim.z;vUb=ub;vV=av.x-trim.w;vVBounds=av.yz;vPl=pe;vLd=step(0.,dxm);}