#version 300 es
precision highp float;layout(location=0)in vec2 uv;uniform vec4 rect;uniform vec3 viewport;uniform float mode;uniform vec3 reveal;uniform vec4 cloth;uniform highp sampler2D depthTex;uniform vec2 cover;uniform vec2 relief;out vec2 vUv;out vec3 vNormal;vec3 sheet(vec2 point){vec3 rest=vec3((point.x-.5)*rect.z,(.5-point.y)*rect.w,0.);float bow=sin(point.y*3.14159265);float bend=reveal.y*bow;rest.x+=reveal.z*bend*rect.z*.14;rest.z=bend*rect.z*.06;if(cloth.z<.0001)return rest;vec2 flow=cloth.xy;vec2 crossFlow=vec2(-flow.y,flow.x);float span=max(dot(abs(flow),rect.zw),.001);float crossSpan=max(dot(abs(crossFlow),rect.zw),.001);float along=clamp(dot(rest.xy,flow)/span+.5,0.,1.);float across=dot(rest.xy,crossFlow)/crossSpan;float widthWave=cos(across*3.14159265);float billow=widthWave*(.35+.65*sin(along*3.14159265));float trailing=1.-smoothstep(.1,.9,along);float ripple=sin(along*6.2831853-cloth.w*3.9269908+across*1.2)*trailing*widthWave;rest.xy+=flow*cloth.z*rect.z*(billow*.13+ripple*.022);rest.z+=cloth.z*rect.z*(billow*.28+ripple*.07);return rest;}void main(){vUv=uv;vNormal=vec3(0.,0.,1.);if(mode<.5){gl_Position=vec4(uv*2.-1.,0.,1.);return;}vec3 surface=sheet(uv);float deformation=max(reveal.y,cloth.z);if(deformation>=.0001){vec3 tangentX=sheet(uv+vec2(.001,0.))-surface;vec3 tangentY=sheet(uv+vec2(0.,.001))-surface;vNormal=normalize(cross(tangentY,tangentX));if(relief.x>0.){float depth=texture(depthTex,(uv-.5)/cover+.5).r-.5;float inset=sin(uv.x*3.14159265)*sin(uv.y*3.14159265);surface+=vNormal*depth*inset*inset*relief.x*deformation*rect.z*.024;}}float height=viewport.y+viewport.z*2.;vec2 center=rect.xy+rect.zw*.5;vec2 origin=vec2(center.x/viewport.x*2.-1.,1.-(center.y+viewport.z)/height*2.);vec2 offset=vec2(surface.x/viewport.x*2.,-surface.y/height*2.);gl_Position=vec4(origin+offset,0.,1.);}