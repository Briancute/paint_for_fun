#version 300 es
precision highp float;uniform sampler2D matcap;uniform float o;uniform float rim;in vec3 vN;in vec3 vV;in vec2 vP;out vec4 color;const float INSET=0.485;float panel(vec2 direction,vec2 center,vec2 size,float feather){vec2 edge=abs(direction-center)-size;float distance=max(edge.x,edge.y);return 1.-smoothstep(-feather,feather,distance);}float reflectionFootprint(){float w=gl_FragCoord.w;vec3 normalX=(dFdx(vN*w)-vN*dFdx(w))/w;vec3 normalY=(dFdy(vN*w)-vN*dFdy(w))/w;vec2 positionX=(dFdx(vP*w)-vP*dFdx(w))/w;vec2 positionY=(dFdy(vP*w)-vP*dFdy(w))/w;return 2.*length(abs(normalX)+abs(normalY))/max(length(vN),.001)+2.*length((abs(positionX)+abs(positionY))*vec2(.07,.23));}void main(){vec3 n=normalize(vN);if(!gl_FrontFacing)n=-n;float letterX=(vP.x-(vP.x<0.?-.5:.5))*2.;vec3 crowned=normalize(n+vec3(letterX*.07,vP.y*.23,0.)*pow(abs(n.z),8.));vec2 d=crowned.xy;vec3 c=texture(matcap,d/max(1.,length(d))*INSET+0.5).rgb;vec3 reflection=reflect(-normalize(vV),crowned);vec2 room=reflection.xy;float footprint=reflectionFootprint();float ceiling=panel(room,vec2(0.,.72),vec2(.9,.4),max(.14,footprint));float fill=panel(room,vec2(-.2,-.12),vec2(.7,.74),max(.22,footprint));float edges=panel(vec2(abs(room.x),room.y),vec2(.91,.06),vec2(.055,.94),max(.07,footprint));float facing=clamp(dot(n,normalize(vV)),0.,1.);float studio=.08+.04*smoothstep(-.65,.7,reflection.y);studio=mix(studio,.4+.34*smoothstep(-.75,.35,room.y),fill);studio=mix(studio,1.18,ceiling);studio=mix(studio,.87,edges*smoothstep(.25,.7,1.-facing)*.65);float lum=mix(studio,dot(c,vec3(.2126,.7152,.0722)),.025);lum+=rim*pow(1.-facing,4.);color=vec4(vec3(clamp(lum,0.,1.)),o);}