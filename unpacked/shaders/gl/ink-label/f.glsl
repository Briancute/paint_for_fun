#version 300 es
precision highp float;uniform sampler2D media;uniform sampler2D previous;uniform vec2 res;uniform float progress;uniform float ink;in vec2 vUv;out vec4 color;float grain(vec2 p){vec2 cell=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);vec4 n=fract(sin(vec4(dot(cell,vec2(127.1,311.7)),dot(cell+vec2(1.,0.),vec2(127.1,311.7)),dot(cell+vec2(0.,1.),vec2(127.1,311.7)),dot(cell+1.,vec2(127.1,311.7))))*43758.5453);return mix(mix(n.x,n.y,f.x),mix(n.z,n.w,f.x),f.y);}vec4 pigment(vec4 print){return vec4(print.rgb/max(print.a,.00001)*ink,print.a);}void main(){float p=clamp(progress,0.,1.);if(p<=0.){color=pigment(texture(previous,vUv));return;}if(p>=1.){color=pigment(texture(media,vUv));return;}float wet=4.*p*(1.-p);vec2 pixel=1./max(res,vec2(1.));vec2 point=vUv*res;float fiber=grain(point*.18);vec2 drift=vec2(1.8,.5)*(fiber-.5)*wet*pixel;vec2 spread=vec2(1.15,.35)*wet*pixel;vec4 old=vec4(0.);vec4 next=vec4(0.);for(int i=-3;i<=3;i++){float weight=i==0?.28:abs(i)==1?.22:abs(i)==2?.10:.04;old+=texture(previous,vUv+drift*p+spread*float(i))*weight;next+=texture(media,vUv-drift*(1.-p)+spread*float(i))*weight;}float blend=clamp(p+(fiber-.5)*.16*wet,0.,1.);vec4 print=mix(old,next,blend);color=pigment(print);}