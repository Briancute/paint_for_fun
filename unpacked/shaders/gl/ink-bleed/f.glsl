#version 300 es
precision highp float;uniform sampler2D media;uniform sampler2D previous;uniform sampler2D continuing;uniform vec2 res;uniform vec2 cover;uniform vec2 carryCover;uniform vec3 carryFront;uniform float progress;uniform float seed;uniform float retarget;uniform float alpha;in vec2 vUv;out vec4 color;float hash(vec2 p){vec3 q=fract(vec3(p.xyx)*.1031);q+=dot(q,q.yzx+33.33);return fract((q.x+q.y)*q.z);}float noise(vec2 p){vec2 cell=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(hash(cell),hash(cell+vec2(1.,0.)),f.x),mix(hash(cell+vec2(0.,1.)),hash(cell+1.),f.x),f.y);}float fibers(vec2 p){float n=0.;float amplitude=.5;for(int i=0;i<4;i++){n+=amplitude*noise(p);p=mat2(.8,-.6,.6,.8)*p*2.07+17.3;amplitude*=.5;}return n;}vec4 printColor(vec4 ink){return alpha>.5?vec4(ink.rgb/max(ink.a,.00001),ink.a):ink;}vec3 absorption(float grainSeed){vec2 size=max(res,vec2(1.));vec2 p=(vUv-.5)*vec2(size.x/size.y,1.);vec2 origin=vec2(grainSeed*13.7,grainSeed*7.9);vec2 warp=vec2(fibers(p*4.+origin),fibers(p*4.+origin+31.7))-.46875;vec2 wet=p+warp*.19;float branching=fibers(wet*12.+origin);float fine=fibers(wet*48.+origin+7.3);float arrival=length(wet*vec2(.94,1.06))+(branching-.46875)*.17+(fine-.46875)*.075;return vec3(arrival,max(fwidth(arrival),.006),fine);}vec2 coverage(vec3 field,float amount){vec2 size=max(res,vec2(1.));float reach=mix(-.15,length(vec2(size.x/size.y,1.))*.5+.25,amount);float pigment=smoothstep(field.x-field.y,field.x+.035,reach-.025);float moisture=smoothstep(field.x-.12,field.x+.045,reach)*(.22+.18*field.z);return vec2(pigment,moisture);}void main(){vec4 current=texture(media,(vUv-.5)/cover+.5);if(alpha<.5)current.a=1.;if(progress>=1.){color=printColor(current);return;}vec4 old=texture(previous,vUv);if(progress<=0.){color=printColor(old);return;}vec3 field=absorption(seed);if(carryFront.z>.5){vec2 before=coverage(field,carryFront.x);vec2 after=coverage(field,carryFront.y);float initial=max(before.x,before.y);float advanced=max(after.x,after.y);float additional=clamp((advanced-initial)/max(1.-initial,.00001),0.,1.);vec4 ink=texture(continuing,(vUv-.5)/carryCover+.5);if(alpha<.5)ink.a=1.;old=mix(old,ink,additional);}vec2 ink=coverage(field,progress);float pigment=ink.x;float moisture=ink.y;float mask=max(pigment,moisture);vec4 blended=mix(old,current,mask);blended.rgb*=1.-max(0.,moisture-pigment)*.16*(1.-retarget)*(1.-alpha);color=alpha>.5?vec4(blended.rgb/max(blended.a,.00001),blended.a):blended;}